{
  "name": "ms-minutes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One Brain. Many Bodies. A persistent AI companion that inhabits many devices.",
  "license": "MIT",
  "author": "Thrishank Kuntimaddi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thrishankkuntimaddi/MsMinutes.git"
  },
  "homepage": "https://github.com/thrishankkuntimaddi/MsMinutes#readme",
  "bugs": "https://github.com/thrishankkuntimaddi/MsMinutes/issues",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "vite apps/web-body",
    "dev:brain": "tsx watch --env-file-if-exists=.env apps/brain/src/main.ts",
    "start:brain": "tsx --env-file-if-exists=.env apps/brain/src/main.ts",
    "stub-body": "tsx --env-file-if-exists=.env apps/stub-body/src/main.ts",
    "schema:generate": "tsx packages/protocol/scripts/generate-json-schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web-body/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web-body/tsconfig.json && eslint . && prettier --check . && vitest run",
    "firmware:presets": "tsx packages/character/scripts/generate-firmware-presets.ts",
    "firmware:check": "make -C firmware/desk-companion/host check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
