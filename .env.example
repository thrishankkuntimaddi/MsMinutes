# Who does her thinking: "claude" (default) or "ollama" (local, no API key)
LLM_PROVIDER=claude

# Claude. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low

# Ollama (LLM_PROVIDER=ollama). The model must support tool calling.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Who she lives with, and where (for time-of-day awareness)
USER_NAME=Thrishank
TIMEZONE=Asia/Kolkata

# Her voice: "kokoro" (local neural voice, ~330 MB download on first run) or "none"
# (each body uses its own, e.g. the browser's voices)
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1

# Her hearing: "local" (speech recognition on this machine; Moonshine ~250 MB on first run)
# or "none" (each body transcribes, e.g. the browser's own recognition)
STT_PROVIDER=local
STT_MODEL=onnx-community/moonshine-base-ONNX

# Her long-term memory (ARCHITECTURE §11). A folder path stores it with PGlite (embedded
# Postgres + pgvector, no server); a postgres:// URL uses a server (infra/docker-compose.yml);
# "off" disables it. Extraction uses Claude Haiku 4.5, or OLLAMA_MODEL when running locally.
MEMORY_DB=./data/memory
# MEMORY_MODEL=claude-haiku-4-5
# EMBED_PROVIDER=ollama   # or "local" (in-process MiniLM); defaults to ollama with LLM_PROVIDER=ollama

# Skills (ARCHITECTURE §12): where "the weather" means when no place is given
# (her timers and reminders need no setup). SKILLS_GRANT lists tier-2 skills you allow;
# SKILLS_DENY switches skills off, e.g. SKILLS_DENY=weather.get
# WEATHER_PLACE=Hyderabad
SKILLS_GRANT=
SKILLS_DENY=

# Brain
HOST=127.0.0.1
PORT=7700
LOG_LEVEL=info
PERSONA_NAME="Ms. Minutes"
HEARTBEAT_INTERVAL_MS=15000
HELLO_TIMEOUT_MS=10000

# Stub body
BRAIN_URL=ws://127.0.0.1:7700/ws
BODY_ID=stub-01
